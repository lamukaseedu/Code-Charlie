{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c4a94eb3943f406595a75638d286b5ac",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Sprite3DVertex (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -900.0,
            "y": -650.0,
            "width": 220.0,
            "height": 200.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "c287d839180a45c984d527900efb6273"
        },
        {
            "m_Id": "cf8fc3a1acb74f3eb6773ff46ae73bdc"
        },
        {
            "m_Id": "af8e8a9a4851490cbb453ab6c013cda8"
        },
        {
            "m_Id": "d06a6c55042d4831a004f30fa0e78125"
        },
        {
            "m_Id": "9ea520cfb0c7494bb3c1f4ea22d10aa7"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Sprite3DVertex",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "float2 flip = float2(1, 1);\n#if !defined(SHADERGRAPH_PREVIEW)\nflip.x = unity_SpriteProps.x < 0 ? -1 : 1;\nflip.y = unity_SpriteProps.y < 0 ? -1 : 1;\n#endif\n\n// Flip the sprite and its normal map together.\nPosition = PositionOS;\nPosition.xy *= flip;\nTangent = TangentOS;\nTangent.xy *= flip;\n\n// Sprites face local -Z.\nNormal = float3(0, 0, -1);"
}

