{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "342ab5e5c1a446f9b89a024755556713",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Sprite3DSurface (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -470.0,
            "y": 50.0,
            "width": 220.0,
            "height": 200.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "7bd355955fea4be39ea9fc8a3d4c7977"
        },
        {
            "m_Id": "ff82bf01447449ad94d6f7321867233b"
        },
        {
            "m_Id": "d2fc166b6a424b58878db96fbfc0dbe1"
        },
        {
            "m_Id": "9d2c818c35874109a45a79490cbacc96"
        },
        {
            "m_Id": "785142a6a06a497fa13ce126e2342879"
        },
        {
            "m_Id": "7fa7f9c8c2cf4b368b481b5eaacf4145"
        },
        {
            "m_Id": "eda79cf7527d406b96c839dbd2a16a26"
        },
        {
            "m_Id": "48f335e8455a45ef9d1098aa0ac073b2"
        },
        {
            "m_Id": "0b452efaed2a44d494a33dcb7f626067"
        },
        {
            "m_Id": "5588d62a23f34cdd9da5b4c78e847e96"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Sprite3DSurface",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "float2 flip = float2(1, 1);\n#if !defined(SHADERGRAPH_PREVIEW)\nflip.x = unity_SpriteProps.x < 0 ? -1 : 1;\nflip.y = unity_SpriteProps.y < 0 ? -1 : 1;\n#endif\n\nfloat4 tint = VertexColor;\n#if !defined(SHADERGRAPH_PREVIEW)\ntint *= unity_SpriteColor;\n#endif\nBaseColor = Sprite.rgb * tint.rgb;\nAlpha = Sprite.a * tint.a;\n\n// Zero strength makes the normal map flat.\nfloat3 normal = NormalTS;\nnormal.xy *= max(Strength, 0);\nnormal.z = max(lerp(1, normal.z, saturate(Strength)), 0.0001);\n\n// Point the normal toward the camera.\nfloat3 front = TransformObjectToWorldNormal(float3(0, 0, -1));\nfloat3 view = GetWorldSpaceNormalizeViewDir(PositionWS);\nif (dot(front, view) < 0)\n    front = -front;\n\n// Keep the bumps lined up when the sprite is flipped.\nfloat3 right = normalize(TangentWS) * normal.x;\nfloat3 up = normalize(BitangentWS) * (normal.y * flip.x * flip.y);\nNormalWS = normalize(right + up + front * normal.z);"
}

