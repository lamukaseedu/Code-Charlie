{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "058b7e9863424dcdb44691dd39be5f35",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Sprite3DBacklight (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -150.0,
            "y": 650.0,
            "width": 230.0,
            "height": 250.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "ed1f97f2430747caa077a91f34b7e7c9"
        },
        {
            "m_Id": "1b8ea9a7aa85482fbb8820a6905f4b51"
        },
        {
            "m_Id": "3dc47938a4ef46fab8ba4b271ac60035"
        },
        {
            "m_Id": "245dcc77cf034e4b910e974839c37a01"
        },
        {
            "m_Id": "92f4ddee100e41adbe9fdd8d2604dd73"
        },
        {
            "m_Id": "b60e3aac8311484f83467bbaad428d58"
        },
        {
            "m_Id": "ec6e9c98706d4cb3b7787921d1438411"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Sprite3DBacklight",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "Emission = 0;\n#if !defined(SHADERGRAPH_PREVIEW) && (SHADERPASS == SHADERPASS_FORWARD)\nStrength = saturate(Strength);\nWrap = saturate(Wrap);\nif (Strength == 0 && Wrap == 0)\n    return;\n\nfloat3 normal = normalize(NormalWS);\nfloat3 extraLight = float3(0, 0, 0);\nfloat4 shadowMask = float4(1, 1, 1, 1);\nuint layers = GetMeshRenderingLayer();\n\n#if defined(_MAIN_LIGHT_SHADOWS_SCREEN) && !defined(_SURFACE_TYPE_TRANSPARENT)\nfloat4 shadowCoord = ComputeScreenPos(TransformWorldToHClip(PositionWS));\n#else\nfloat4 shadowCoord = TransformWorldToShadowCoord(PositionWS);\n#endif\n\n// URP already lights the front. Add soft light at the sides and back.\nLight mainLight = GetMainLight(shadowCoord, PositionWS, shadowMask);\n#ifdef _LIGHT_LAYERS\nif (IsMatchingLightLayer(mainLight.layerMask, layers))\n#endif\n{\n    float angle = dot(normal, mainLight.direction);\n    float front = saturate((angle + Wrap) / (1 + Wrap));\n    float back = saturate((-angle + Wrap) / (1 + Wrap));\n    float amount = max(front - saturate(angle), 0) + Strength * back;\n    float3 color = mainLight.color * (mainLight.distanceAttenuation * mainLight.shadowAttenuation);\n    extraLight += color * amount;\n}\n\n#if defined(_ADDITIONAL_LIGHTS) || defined(_ADDITIONAL_LIGHTS_VERTEX)\nInputData inputData = (InputData)0;\ninputData.positionWS = PositionWS;\ninputData.normalizedScreenSpaceUV = GetNormalizedScreenSpaceUV(PixelPosition);\nuint lightCount = GetAdditionalLightsCount();\n\n#if USE_CLUSTER_LIGHT_LOOP\n// Forward+ keeps extra directional lights in a separate list.\n[loop] for (uint lightIndex = 0; lightIndex < min(URP_FP_DIRECTIONAL_LIGHTS_COUNT, MAX_VISIBLE_LIGHTS); lightIndex++)\n{\n    CLUSTER_LIGHT_LOOP_SUBTRACTIVE_LIGHT_CHECK\n    Light light = GetAdditionalLight(lightIndex, PositionWS, shadowMask);\n#ifdef _LIGHT_LAYERS\n    if (IsMatchingLightLayer(light.layerMask, layers))\n#endif\n    {\n        float angle = dot(normal, light.direction);\n        float front = saturate((angle + Wrap) / (1 + Wrap));\n        float back = saturate((-angle + Wrap) / (1 + Wrap));\n        float amount = max(front - saturate(angle), 0) + Strength * back;\n        float3 color = light.color * (light.distanceAttenuation * light.shadowAttenuation);\n        extraLight += color * amount;\n    }\n}\n#endif\n\n// Handle the point and spot lights.\nLIGHT_LOOP_BEGIN(lightCount)\n    Light light = GetAdditionalLight(lightIndex, PositionWS, shadowMask);\n#ifdef _LIGHT_LAYERS\n    if (IsMatchingLightLayer(light.layerMask, layers))\n#endif\n    {\n        float angle = dot(normal, light.direction);\n        float front = saturate((angle + Wrap) / (1 + Wrap));\n        float back = saturate((-angle + Wrap) / (1 + Wrap));\n        float amount = max(front - saturate(angle), 0) + Strength * back;\n        float3 color = light.color * (light.distanceAttenuation * light.shadowAttenuation);\n        extraLight += color * amount;\n    }\nLIGHT_LOOP_END\n#endif\n\nEmission = BaseColor * extraLight;\n#endif"
}

